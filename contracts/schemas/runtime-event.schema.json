{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-crossing.local/schemas/runtime-event.schema.json",
  "title": "RuntimeContracts",
  "$defs": {
    "PromptVersionConflictResponse": {
      "description": "HTTP 409 from /api/runtime/execute before any CLI or callback starts. Recover session context before retrying; other errors are not safe to retry automatically.",
      "type": "object",
      "additionalProperties": false,
      "required": ["detail"],
      "properties": {
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "currentPromptVersion"],
          "properties": {
            "code": {"const": "PROMPT_VERSION_CHANGED"},
            "currentPromptVersion": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "AgentExecutionRequest": {
      "$comment": "MODEL_SYNC(AgentExecutionRequest) — 改字段时三处同步（无 codegen）: contracts/schemas/runtime-event.schema.json ($defs/AgentExecutionRequest) | services/platform-api/src/main/java/com/agentcrossing/platform/application/invocation/AgentExecutionRequest.java | services/agent-runtime/src/agent_runtime/contracts/models.py (class AgentExecutionRequest)",
      "type": "object",
      "additionalProperties": false,
      "required": ["invocationId", "userId", "taskId", "traceId", "agentId", "context"],
      "properties": {
        "invocationId": {
          "type": "string",
          "minLength": 1
        },
        "userId": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "traceId": {
          "type": "string",
          "minLength": 1
        },
        "agentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "context": {
          "type": "string"
        },
        "callbackBaseUrl": {
          "type": "string",
          "format": "uri"
        },
        "providerSessionId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "providerPromptVersion": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "contextPack": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "incrementalChatMessages": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["messageId", "role", "content", "createdAt"],
                "properties": {
                  "messageId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "type": "string",
                    "enum": ["user", "assistant", "system"]
                  },
                  "agentId": {
                    "type": ["string", "null"]
                  },
                  "taskId": {
                    "type": ["string", "null"]
                  },
                  "content": {
                    "type": "string"
                  },
                  "createdAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            },
            "availableAgents": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["agentId", "displayName", "role", "capabilities", "tools"],
                "properties": {
                  "agentId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
                  "displayName": { "type": "string" },
                  "role": { "type": "string" },
                  "capabilities": { "type": "array", "items": { "type": "string" } },
                  "tools": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "startupSummary": {
              "type": ["string", "null"]
            }
          }
        }
      }
    },
    "AgentExecutionUsage": {
      "$comment": "MODEL_SYNC(AgentExecutionUsage) — 改字段时三处同步（无 codegen）: contracts/schemas/runtime-event.schema.json ($defs/AgentExecutionUsage) | services/platform-api/src/main/java/com/agentcrossing/platform/application/invocation/AgentExecutionUsage.java | services/agent-runtime/src/agent_runtime/contracts/models.py (class AgentExecutionUsage)",
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "contextInputTokens", "observedAt"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "providerSessionId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "totalInputTokens": {
          "type": ["integer", "null"],
          "description": "Aggregate input consumption for this invocation, independent of current context length.",
          "minimum": 0
        },
        "lastRequestInputTokens": {
          "type": ["integer", "null"],
          "description": "Explicit last model request input length; takes precedence over contextInputTokens.",
          "minimum": 0
        },
        "usagePrecision": {
          "type": "string",
          "enum": ["EXACT", "TURN_AGGREGATE", "ESTIMATED", "UNKNOWN"],
          "default": "UNKNOWN"
        },
        "inputTokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "cachedInputTokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "cacheCreationInputTokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "cacheReadInputTokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "outputTokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "reasoningOutputTokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "contextInputTokens": {
          "type": ["integer", "null"],
          "description": "Reliable current request input length. Null when only aggregate or unknown usage is available; never inferred from aggregate inputTokens.",
          "minimum": 0
        },
        "rawUsageJson": {
          "type": ["object", "null"]
        },
        "providerCliVersion": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "AgentExecutionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages"],
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "$ref": "agent-message.schema.json"
          }
        },
        "finalText": {
          "type": ["string", "null"]
        },
        "streamCompleted": {
          "type": "boolean"
        },
        "lastSequence": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "promptVersion": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentExecutionUsage"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
