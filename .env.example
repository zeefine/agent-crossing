# Agent Crossing local development defaults

PLATFORM_API_HOST=127.0.0.1
PLATFORM_API_PORT=8080
AGENT_RUNTIME_HOST=127.0.0.1
AGENT_RUNTIME_PORT=8090

AGENT_RUNTIME_BASE_URL=http://127.0.0.1:8090
PLATFORM_API_BASE_URL=http://127.0.0.1:8080
AGENT_RUNTIME_PROVIDER_TIMEOUT_SECONDS=100
AGENT_RUNTIME_CLI_WORKING_DIRECTORY=/Users/fine/PyProjects/agent-crossing
# ClaudeCode business agent and MasterAgent use this HTTP MCP endpoint by default.
AGENT_RUNTIME_MASTER_AGENT_MCP_URL=http://127.0.0.1:8090/mcp/master-agent/
# Optional override when ClaudeCode needs a custom MCP config JSON.
# AGENT_RUNTIME_CLAUDECODE_MCP_CONFIG_JSON={"mcpServers":{"agent-crossing":{"type":"http","url":"http://127.0.0.1:8090/mcp/master-agent/"}}}

DEFAULT_AGENT_ID=opencode

# Default development storage.
STORAGE_MODE=memory

# Enable MySQL-backed realtime EventLog with:
# SPRING_PROFILES_ACTIVE=mysql
MYSQL_SERVER=localhost
MYSQL_PORT=13306
MYSQL_DB=agent_crossing
# Replace with local credentials in .env; do not commit real secrets.
MYSQL_USER=<mysql-user>
MYSQL_PASSWORD=<mysql-password>
